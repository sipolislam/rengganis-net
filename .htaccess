Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:config|database|includes|tests|docs|kit|storage|\.git|\.github)(?:/|$) - [F,L,NC]
</IfModule>
<FilesMatch "^(?:\.env(?:\..*)?|\.gitignore|\.dockerignore|Dockerfile(?:\.vercel)?|README\.md|AGENTS\.md|SPEC\.json)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
